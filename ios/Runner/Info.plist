<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Fibu</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>fibu</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
		Export-Compliance (US EAR / EU Dual-Use-VO 2021/821).
		Fibu nutzt ausschließlich (a) TLS/HTTPS aus den Betriebssystem- bzw.
		Standard-Bibliotheken und (b) die Krypto-Routinen von rclone, die auf
		golang.org/x/crypto aufsetzen. Beides fällt unter die Ausnahmen für
		Standard-/Massenmarkt-Kryptographie (5D992.c bzw. EU Anhang II Nr. 4).
		Deshalb: false. Ohne diesen Schlüssel fragt App Store Connect bei
		jedem Build erneut nach der Export-Compliance.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Damit deine Fotos und Videos 1:1 in deiner eigenen Cloud landen.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Damit wiederhergestellte Fotos und Videos zurück in deine Mediathek kommen.</string>
	<!--
		Lokales Netz (iOS 14+). Ohne diesen Schlüssel zeigt iOS den
		Berechtigungs-Dialog für das lokale Netz gar nicht erst an und
		blockiert Broadcast/Unicast ins eigene Netz still — die automatische
		Geräte-Erkennung der Konfig-Übertragung (UDP-Beacon, Port 47831,
		siehe device_pairing_service.dart) würde damit nie ein Gerät finden.
		Da die Erkennung der einzige Weg zur Konfig-Übertragung ist, ist
		dieser Eintrag Pflicht, nicht Deko.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Damit sich deine Fibu-Geräte im selben WLAN finden und Laufwerke, Zugangsdaten und Aufgaben direkt untereinander übertragen können — ohne Server dazwischen.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.example.fibu.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fibuoauth</string>
			</array>
		</dict>
	</array>
	<!--
		Flutter-Deep-Linking AUS: Der Widget-Tap liefert fibu://open — mit
		aktiviertem Deep-Linking pusht Flutter daraus eine Phantom-Route
		(Dashboard-Kopie mit Zurück-Button). Die App soll beim Widget-Tap
		einfach im aktuellen Zustand öffnen. OAuth (flutter_web_auth_2)
		nutzt ASWebAuthenticationSession und braucht dieses Flag nicht.
	-->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>workmanager.background.task</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
